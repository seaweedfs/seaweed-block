{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string" }
      }
    },
    "csiImage": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string" }
      }
    },
    "storageClass": {
      "type": "object",
      "properties": {
        "replicationFactor": { "type": "integer", "minimum": 1 },
        "protocol": { "type": "string", "enum": ["iscsi", "nvme"] }
      }
    },
    "blockmaster": {
      "type": "object",
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "failbackRuntimeRPC": { "type": "boolean" },
        "durableImpl": { "type": "string", "enum": ["walstore", "smartwal"] },
        "stateHostPath": { "type": "string" },
        "stateHostPathType": { "type": "string" },
        "statePermissionsImage": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "digest": { "type": "string" },
            "pullPolicy": { "type": "string" }
          }
        }
      }
    },
    "restartPersistence": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["ephemeral", "hostpath"] },
        "stateHostPath": { "type": "string" }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "externalISCSI": { "type": "boolean" },
        "externalNVMe": { "type": "boolean" },
        "externalStatus": { "type": "boolean" },
        "rejectLoopbackPublishTargets": { "type": "boolean" }
      }
    },
    "ports": {
      "type": "object",
      "properties": {
        "iscsiBase": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nvmeBase": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "statusBase": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "compat": {
      "type": "object",
      "properties": {
        "launcherDurableImplFlag": { "type": "boolean" },
        "launcherReplicationAckFlag": { "type": "boolean" },
        "launcherRejectLoopbackFlag": { "type": "boolean" }
      }
    },
    "blockNodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "internalIP"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "serverID": { "type": "string" },
          "internalIP": { "type": "string", "minLength": 1 },
          "dataPort": { "type": "integer", "minimum": 1 },
          "ctrlPort": { "type": "integer", "minimum": 1 },
          "poolID": { "type": "string" }
        }
      }
    },
    "operatorStatus": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "dryRun": { "type": "boolean" },
        "interval": { "type": "string" },
        "clusterName": { "type": "string" },
        "rbac": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "failbackTargetOwner": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "dryRun": { "type": "boolean" },
        "interval": { "type": "string" },
        "activation": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "policy": { "type": "boolean" },
            "runtimeEndpoint": { "type": "string" }
          }
        },
        "rbac": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "failbackExecutor": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "dryRun": { "type": "boolean" },
        "interval": { "type": "string" },
        "execution": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "policy": { "type": "boolean" },
            "failbackRuntimeGrpcAddr": { "type": "string" },
            "failbackRuntimeURL": { "type": "string" }
          }
        },
        "rbac": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
