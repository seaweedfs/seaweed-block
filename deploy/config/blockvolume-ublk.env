# Overrides for the root ublk variant (deploy/systemd/sw-blockvolume-ublk.service).
# Install as /etc/sw-block/blockvolume-ublk.env. The unit reads
# blockvolume.env first and this file second; values here win.
#
# The ublk unit runs as root, so it gets its own state directory
# (StateDirectory=sw-block-volume-ublk, /var/lib/sw-block-volume-ublk). It never
# touches /var/lib/sw-block-master or /var/lib/sw-block-volume.
#
# Not a data migration: switching from sw-blockvolume to this unit does not
# move or reopen the volume under /var/lib/sw-block-volume; this unit creates
# a new, empty volume in its own directory.

# --durable-root for the root-owned service.
SWB_DURABLE_ROOT=/var/lib/sw-block-volume-ublk/volumes
# --ublk-device: serve the volume as /dev/ublkb0. The id must be free: the
# server refuses an id whose device already exists.
SWB_UBLK_DEVICE=0
# NVMe/TCP off for this variant.
SWB_NVME_LISTEN=
SWB_NVME_SUBSYSNQN=
