# Seaweed Block: example settings for blockmaster
# (deploy/systemd/sw-blockmaster.service). Install as
# /etc/sw-block/blockmaster.env.
#
# The binaries are configured by command-line flags. The SWB_* variables in
# this file exist only so the example unit can build those flags; blockmaster
# does not read them. Each entry names the flag it feeds, the flag's default,
# and what it means.
#
# State: the unit's StateDirectory=sw-block-master creates
# /var/lib/sw-block-master, owned by the sw-block user. Only blockmaster
# writes there.

# ---------------------------------------------------------------- blockmaster

# --authority-store (required, no default). Durable authority store directory:
# assignments, epochs, leases. Losing it loses the epoch history.
SWB_MASTER_AUTHORITY_STORE=/var/lib/sw-block-master/authority
# --listen (default 127.0.0.1:0). gRPC listen address. The control plane has
# no authentication; keep it on loopback or a trusted network.
SWB_MASTER_LISTEN=127.0.0.1:9180
# --topology (default empty: no assignments are minted). Accepted-topology
# YAML: volumes and their replica slots. See deploy/config/topology.yaml.
SWB_MASTER_TOPOLOGY=/etc/sw-block/topology.yaml
# --expected-slots-per-volume (default 3). Replica slots per volume; must match
# the topology. 1 for a single-replica volume.
SWB_MASTER_EXPECTED_SLOTS=1
# --freshness-window (default 30s). How long a server's heartbeat stays fresh.
SWB_MASTER_FRESHNESS_WINDOW=30s
# --pending-grace (default 1s). Startup grace before a missing observation is
# reported as unsupported.
SWB_MASTER_PENDING_GRACE=1s
# --workspace-rpc (default false). Enable the workspace lease, revocation and
# move RPCs (agent workspace disks, proof of concept).
SWB_MASTER_WORKSPACE_RPC=false
# --workspace-head-base-url (default empty; required with --workspace-rpc).
# Filer HTTP directory that holds the per-volume HEAD files.
SWB_MASTER_WORKSPACE_HEAD_BASE_URL=
# --workspace-max-clock-skew (default 20s; must be >10.1s and <60s). Host leases
# shorten by half of it; forced moves wait the full bound.
SWB_MASTER_WORKSPACE_MAX_CLOCK_SKEW=20s
# Extra blockmaster flags, split on spaces.
# A standalone workspace volume (lease, planned hand-over) needs --cluster-spec,
# --lifecycle-store and the --workspace-* flags here: see docs/volume-lifecycle.md.
# Kubernetes launcher/runtime flags are configured separately by the Helm chart.
SWB_MASTER_EXTRA_ARGS=
